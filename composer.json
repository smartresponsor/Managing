{
  "name": "managing/manage",
  "description": "Managing process app",
  "type": "symfony-bundle",
  "license": "proprietary",
  "require": {
    "php": "^8.4",
    "administering/administration": "dev-master",
    "doctrine/doctrine-bundle": "^3.0",
    "doctrine/orm": "^3.3",
    "easycorp/easyadmin-bundle": "^5.5.1",
    "cruding/crud": "dev-master",
    "interfacing/interface": "dev-master",
    "objecting/object": "dev-master",
    "viewing/view": "dev-master",
    "symfony/config": "^8.1",
    "symfony/dependency-injection": "^8.1",
    "symfony/form": "^8.1",
    "symfony/framework-bundle": "^8.1",
    "symfony/routing": "^8.1",
    "symfony/ux-live-component": "^3.1",
    "symfony/ux-turbo": "^3.0",
    "symfony/yaml": "^8.1",
    "twig/html-extra": "^3.24"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.65",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^12.0",
    "symfony/browser-kit": "^8.1",
    "symfony/css-selector": "^8.1"
  },
  "autoload": {
    "psr-4": {
      "App\\Managing\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Managing\\Tests\\": "tests/"
    }
  },
  "repositories": [
    {"type": "path", "url": "../Administering", "options": {"symlink": true}},
    {"type": "path", "url": "../Cruding", "options": {"symlink": true}},
    {"type": "path", "url": "../Collectioning", "options": {"symlink": true}},
    {"type": "path", "url": "../Tabling", "options": {"symlink": true}},
    {"type": "path", "url": "../Interfacing", "options": {"symlink": true}},
    {"type": "path", "url": "../Objecting", "options": {"symlink": true}},
    {"type": "path", "url": "../Viewing", "options": {"symlink": true}}
  ],
  "scripts": {
    "test": "phpunit",
    "test:coverage": "@php -d xdebug.mode=coverage vendor/bin/phpunit --coverage-text=var/coverage-summary.txt",
    "phpstan": "phpstan analyse -c phpstan.neon --memory-limit=1G",
    "cs:check": "php-cs-fixer fix --config=.php-cs-fixer.dist.php --dry-run --diff --verbose",
    "cs:fix": "php-cs-fixer fix --config=.php-cs-fixer.dist.php --verbose",
    "quality": ["@cs:check", "@phpstan", "@test"]
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "config": {
    "allow-plugins": {
      "symfony/flex": true,
      "symfony/runtime": true
    },
    "sort-packages": true
  }
}
