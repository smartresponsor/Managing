#!/usr/bin/env php
<?php

declare(strict_types=1);

use App\Managing\Kernel;
use Symfony\Bundle\FrameworkBundle\Console\Application;

if (!is_file(dirname(__DIR__).'/vendor/autoload.php')) {
    fwrite(STDERR, "vendor/autoload.php is missing. Run composer install before using bin/console.\n");
    exit(1);
}

require_once dirname(__DIR__).'/vendor/autoload.php';

$env = (string) ($_SERVER['APP_ENV'] ?? $_ENV['APP_ENV'] ?? 'dev');
foreach (is_array($_SERVER['argv'] ?? null) ? $_SERVER['argv'] : [] as $argument) {
    if (is_string($argument) && str_starts_with($argument, '--env=')) {
        $requestedEnv = substr($argument, 6);
        if ('' !== $requestedEnv) {
            $env = $requestedEnv;
        }
    }
}

$_SERVER['APP_ENV'] = $_ENV['APP_ENV'] = $env;
$debugValue = (string) ($_SERVER['APP_DEBUG'] ?? $_ENV['APP_DEBUG'] ?? ('prod' !== $env ? '1' : '0'));
$debug = '0' !== $debugValue && '' !== $debugValue;

$application = new Application(new Kernel($env, $debug));
$application->setAutoExit(true);

exit($application->run());
